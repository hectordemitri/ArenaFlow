# ArenaFlow backend environment
# Copy to .env in each environment. Do not commit real secrets.

# Application
DEBUG=True
SECRET_KEY=change-me-in-production
# Comma-separated Fernet keys; first encrypts, remaining keys decrypt old data.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEYS=
SUPERADMIN_REQUIRE_MFA=False
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
DEMO_MODE=True
DEMO_ADMIN_PASSWORD=set-a-strong-demo-password-outside-source-control
DEFAULT_ARENA_SLUG=arenasystem-demo

# CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security and proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False

# Rate limits
THROTTLE_AUTH_LOGIN=8/min
THROTTLE_AUTH_REGISTER=5/hour

# Uploads
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
# Separate private bucket, with versioning, encryption and retention configured.
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=us-east-1
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
IMAGE_UPLOAD_MAX_SIZE=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Student dues: each arena connects its own seller account through OAuth.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://127.0.0.1:8000/api/mercado-pago/callback/
MERCADO_PAGO_WEBHOOK_SECRET=
# Separate credentials for the subscription paid by arenas to ArenaFlow.
MERCADO_PAGO_SAAS_ACCESS_TOKEN=
MERCADO_PAGO_SAAS_WEBHOOK_SECRET=
MERCADO_PAGO_SAAS_COLLECTOR_ID=
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
DEFAULT_FROM_EMAIL=ArenaFlow <noreply@example.com>
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# Database
# Development uses SQLite when this is empty. In Render, use the dedicated
# Supabase PostgreSQL connection string (prefer the session pooler).
DATABASE_URL=
